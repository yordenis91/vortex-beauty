// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ================= Enums =================

enum Role {
  OWNER // Dueño del salón: todo, incluida la facturación del plan
  ADMIN // Operación del salón
  STAFF // Profesional: solo su propia agenda
  CLIENT // Cuenta de cliente final (opcional)
}

enum TenantStatus {
  ACTIVE
  TRIAL
  SUSPENDED
}

// ================= Plataforma (Super Admin) =================
// Todo lo de aquí abajo es a nivel de la plataforma SaaS, no de un salón
// (tenant) concreto: quién administra la plataforma, qué le cobra a cada
// salón y con qué plan. Se mantiene deliberadamente separado de los modelos
// de negocio de cada salón: esto es lo que EL SAAS le cobra AL SALÓN.

enum PlatformRole {
  SUPER_ADMIN
  SUPPORT
  BILLING_ADMIN
}

enum TenantSubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum PlatformInvoiceStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  VOID
}

enum AuditActorType {
  PLATFORM_ADMIN
  TENANT_USER
}

// ================= Models =================

// Un Tenant representa un salón individual suscrito al SaaS. Es la base de la
// separación multitenant: toda tabla de datos de negocio lleva tenantId para
// que los datos de un salón nunca sean visibles para otro.
//
// tenantId es obligatorio (NOT NULL) en todas las tablas de datos de negocio.
model Tenant {
  id       String       @id @default(uuid())
  name     String // Nombre comercial del salón
  slug     String       @unique // Para URLs/subdominio futuro (ej. saloncarla)
  currency String       @default("USD")
  timezone String       @default("UTC")
  status   TenantStatus @default(ACTIVE)

  users                  User[]
  clients                Client[]
  services               Service[]
  categories             Category[]
  professionals          Professional[]
  professionalServices   ProfessionalService[]
  professionalSchedules  ProfessionalSchedule[]
  professionalQuotaSlots ProfessionalQuotaSlot[]
  timeOffs               TimeOff[]
  resources              Resource[]
  serviceResources       ServiceResource[]
  locations              Location[]
  settings               TenantSettings?
  appointments           Appointment[]
  businessHours          BusinessHour[]
  closedDates            ClosedDate[]
  scheduleOverrides      ScheduleOverride[]
  notifications          Notification[]
  galleryItems           GalleryItem[]

  // Suscripción de este salón a un Plan de la plataforma (lo que el SaaS le
  // cobra al salón), y sus facturas de plataforma.
  platformSubscription TenantSubscription?
  platformInvoices     PlatformInvoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id       String  @id @default(uuid())
  email    String
  username String?
  password String // Hash de la contraseña (e.g., bcrypt)
  name     String
  role     Role    @default(CLIENT) // ADMIN o CLIENT
  // Una cuenta desactivada no puede iniciar sesión ni renovar su sesión.
  isActive Boolean @default(true)

  // Salón al que pertenece este usuario (admin o clienta).
  tenantId String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Foto de perfil (Base64)
  imageUrl String? @db.Text

  // Relación con Client (un user puede estar asociado a un cliente)
  clientId String?
  client   Client? @relation("UserAsClient", fields: [clientId], references: [id], onDelete: SetNull)

  // Relaciones existentes
  clients       Client[]       @relation("AdminofClient") // Relación inversa: admin de varios clientes
  professional  Professional?
  refreshTokens RefreshToken[]
  calendarFeed  CalendarFeed?
  services      Service[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, email])
  @@unique([tenantId, username])
  @@index([clientId])
  @@index([tenantId])
}

model Client {
  id    String  @id @default(uuid())
  name  String
  email String? // opcional: un cliente de reserva pública puede identificarse solo por teléfono
  code  String?

  // Salón al que pertenece esta clienta.
  tenantId String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  displayName    String?
  // Archivado: fuera de las listas y de las citas nuevas, con su historial intacto. null = activo.
  archivedAt     DateTime?
  phone          String?
  // Teléfono normalizado (solo dígitos) para reconocer al mismo cliente entre reservas.
  phoneKey       String?
  // Chat de Telegram al que el cliente pidió recibir sus avisos (enlazado desde el bot del salón).
  telegramChatId String?
  address        String? @db.Text
  city           String?
  state          String?
  zipCode        String?
  country        String?
  currency       String  @default("USD")

  // Foto de perfil (Base64)
  imageUrl String? @db.Text

  // Claves foráneas
  userId String
  user   User   @relation("AdminofClient", fields: [userId], references: [id], onDelete: Cascade)

  // Usuarios (clientes) vinculados a este cliente
  clientUsers User[] @relation("UserAsClient")

  // Relaciones existentes

  // Relación con citas
  appointments Appointment[]

  // Relación con notificaciones
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, email])
  @@unique([tenantId, phoneKey])
  @@index([userId])
  @@index([tenantId])
  @@index([tenantId, telegramChatId])
}

// Categorías para organizar productos y tickets
model Category {
  id          String  @id @default(uuid())
  name        String
  description String?
  color       String? // Para UI (hex color)
  icon        String? // Nombre del icono
  order       Int     @default(0) // Para ordenar categorías

  // Salón al que pertenece esta categoría.
  tenantId String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Relaciones
  services Service[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

// Productos y Servicios
model Service {
  id          String  @id @default(uuid())
  name        String
  description String? @db.Text

  // Precios
  price    Decimal @db.Decimal(10, 2)
  currency String  @default("USD")

  // Estado y configuración
  status          ServiceStatus @default(ACTIVE)
  isPublic        Boolean       @default(true) // Visible en portal de cliente
  durationMinutes Int           @default(60) // Duración del servicio; determina la hora de fin de la cita
  bufferBeforeMin Int           @default(0) // Preparación antes de la cita
  bufferAfterMin  Int           @default(0) // Limpieza/descanso después de la cita
  onlineBookable  Boolean       @default(true) // Se puede reservar desde la página pública

  // Salón al que pertenece este producto/servicio.
  tenantId String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Categorización
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  // Usuario que creó el producto
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Relaciones
  appointments  Appointment[]
  galleryItems  GalleryItem[]
  professionals ProfessionalService[]
  resources     ServiceResource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([userId])
  @@index([tenantId])
}

model GalleryItem {
  id       String  @id @default(uuid())
  title    String
  imageUrl String  @db.Text
  isActive Boolean @default(true)

  // Salón al que pertenece este diseño.
  tenantId String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceId])
  @@index([tenantId])
}

model Professional {
  id       String  @id @default(uuid())
  name     String
  email    String?
  phone    String?
  color    String? // Para distinguir profesionales en la agenda (hex color)
  isActive Boolean @default(true)

  // Si es false, solo se le asignan citas desde el panel (no desde la reserva pública).
  acceptsOnlineBookings Boolean @default(true)

  // TIMED: reserva por hora según su horario. QUOTA: atiende una cantidad fija de
  // clientes por día, a las horas exactas de sus cupos (ProfessionalQuotaSlot).
  bookingMode BookingMode @default(TIMED)

  // Salón al que pertenece este profesional.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Cuenta con la que el profesional inicia sesión (rol STAFF), si la tiene.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Avisos de sus propias citas por el bot del salón. Nunca se devuelven por la API:
  // el profesional los gestiona en GET/DELETE /api/professionals/me/telegram.
  telegramChatId   String?
  telegramLinkCode String?

  appointments Appointment[]
  services     ProfessionalService[]
  schedules    ProfessionalSchedule[]
  quotaSlots   ProfessionalQuotaSlot[]
  timeOffs     TimeOff[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([tenantId])
}

// Servicios que realiza cada profesional.
model ProfessionalService {
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  serviceId      String
  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([professionalId, serviceId])
  @@index([tenantId])
  @@index([serviceId])
}

// Horario semanal de un profesional. Puede haber varios tramos el mismo día
// (jornada partida). Sin tramos ese día, el profesional no trabaja.
model ProfessionalSchedule {
  id             String       @id @default(uuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  dayOfWeek      Int // 0 = Domingo ... 6 = Sábado
  startTime      String // "HH:mm"
  endTime        String // "HH:mm"

  @@index([tenantId])
  @@index([professionalId, dayOfWeek])
}

// Cupo de un profesional que reserva por cupos: una hora exacta de un día de la
// semana en la que atiende a un solo cliente.
model ProfessionalQuotaSlot {
  id             String       @id @default(uuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  dayOfWeek      Int // 0 = Domingo ... 6 = Sábado
  time           String // "HH:mm"

  @@unique([professionalId, dayOfWeek, time])
  @@index([tenantId])
}

// Ausencia de un profesional (vacaciones, enfermedad, descanso).
model TimeOff {
  id             String       @id @default(uuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  startsAt       DateTime     @db.Timestamptz(3)
  endsAt         DateTime     @db.Timestamptz(3)
  reason         String?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([professionalId, startsAt])
}

// Sede física (preparado para multi-sede; todavía sin interfaz).
model Location {
  id       String  @id @default(uuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name     String
  address  String? @db.Text

  resources Resource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// Recurso físico que una cita ocupa: silla, cabina, camilla, sala.
model Resource {
  id       String  @id @default(uuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name     String
  isActive Boolean @default(true)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  appointments Appointment[]
  services     ServiceResource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// Recursos que puede usar un servicio. Si un servicio no tiene ninguno, no
// necesita recurso. Si tiene alguno, cada cita ocupa uno libre de ellos.
model ServiceResource {
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([serviceId, resourceId])
  @@index([tenantId])
  @@index([resourceId])
}

// Configuración de reservas y vocabulario de cada salón (una fila por salón).
model TenantSettings {
  tenantId String @id
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  vertical             Vertical @default(GENERIC)
  slotIntervalMin      Int      @default(30) // cada cuántos minutos se ofrece un hueco
  minNoticeHours       Int      @default(2) // antelación mínima para reservar
  maxAdvanceDays       Int      @default(60) // hasta cuántos días adelante se puede reservar
  cancelWindowHrs      Int      @default(12) // el cliente puede cancelar hasta X horas antes (0 = siempre)
  bookingEnabled       Boolean  @default(true) // activa la reserva pública
  maxActivePerCustomer Int      @default(3) // citas futuras activas por cliente en la reserva pública

  // Avisos
  reminderHours         Int[]   @default([24, 2]) // horas antes de la cita en que se recuerda al cliente
  ownerAlerts           Boolean @default(true) // avisar al dueño de reservas y cancelaciones
  dailySummary          Boolean @default(true) // resumen de las citas del día por Telegram, a las 8:00 del salón
  telegramBotToken      String? // bot propio del salón para avisos al dueño (nunca se devuelve por la API)
  telegramChatId        String?
  // Bot de clientes: usuario del bot (para el enlace t.me), secreto del webhook y código de un solo uso
  // con el que el dueño enlaza su propio chat enviando /vincular <código>.
  telegramBotUsername   String?
  telegramWebhookSecret String?
  telegramOwnerCode     String?

  // Marca del salón en su página pública de reserva: logo (data URL pequeño) y color #RRGGBB.
  logoUrl    String? @db.Text
  brandColor String?

  // Vocabulario de la interfaz: { "customer": "clienta", "appointment": "cita", ... }
  labels Json @default("{}")

  updatedAt DateTime @updatedAt
}

model Appointment {
  id     String            @id @default(uuid())
  status AppointmentStatus @default(SCHEDULED)
  notes  String?           @db.Text

  // Intervalo del servicio, en instantes absolutos. La hora local del salón se
  // calcula con Tenant.timezone.
  startsAt DateTime @db.Timestamptz(3)
  endsAt   DateTime @db.Timestamptz(3)

  // Intervalo que realmente se ocupa (servicio + preparación y limpieza). Las
  // restricciones EXCLUDE de la base impiden que dos citas del mismo
  // profesional o recurso se solapen en este intervalo.
  blockStartsAt DateTime @db.Timestamptz(3)
  blockEndsAt   DateTime @db.Timestamptz(3)

  // Datos del servicio congelados al reservar: cambiar el servicio después no
  // reescribe la historia.
  serviceName     String
  priceAmount     Decimal @db.Decimal(10, 2)
  currency        String  @default("USD")
  durationMin     Int
  bufferBeforeMin Int     @default(0)
  bufferAfterMin  Int     @default(0)

  source      BookingSource @default(ADMIN)
  // Secreto del enlace "gestionar mi cita" (cancelar / reprogramar sin cuenta).
  cancelToken String?       @unique
  cancelledBy CancelledBy?
  cancelledAt DateTime?

  // Salón al que pertenece esta cita.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  professionalId String?
  professional   Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)

  resourceId String?
  resource   Resource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, startsAt])
  @@index([tenantId, status])
  @@index([clientId])
  @@index([serviceId])
  @@index([professionalId, startsAt])
  @@index([resourceId, startsAt])
}

model Notification {
  id        String             @id @default(uuid())
  type      NotificationType // WHATSAPP, EMAIL, SYSTEM
  recipient String // Número de teléfono, email o ID interno
  content   String             @db.Text // Texto del mensaje
  status    NotificationStatus @default(PENDING)
  isRead    Boolean            @default(false) // Para la campanita del cliente
  errorLog  String?            @db.Text // Log de errores si falla el envío
  // Evita enviar dos veces el mismo aviso (p. ej. si un trabajo se reintenta).
  dedupeKey String?

  // Salón que envió esta notificación.
  tenantId String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Relaciones
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, dedupeKey])
  @@index([clientId])
  @@index([status])
  @@index([isRead])
  @@index([createdAt])
  @@index([tenantId])
}

// Horarios Comerciales
model BusinessHour {
  id              String   @id @default(uuid())
  dayOfWeek       Int // 0 = Domingo, 1 = Lunes, ..., 6 = Sábado
  startTime       String // Ej: "09:00" (retrocompatibilidad)
  endTime         String // Ej: "18:00" (retrocompatibilidad)
  timeSlots       String[] @default([]) // Horarios explícitos definidos por el administrador
  isOpen          Boolean  @default(true) // Si es false, ese día está cerrado
  maxAppointments Int      @default(0) // 0 = sin límite, >0 = límite máximo de citas por día

  // Salón al que pertenece este horario.
  tenantId String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, dayOfWeek])
  @@index([dayOfWeek])
  @@index([tenantId])
}

model ClosedDate {
  id     String  @id @default(uuid())
  date   String // YYYY-MM-DD
  reason String? @db.Text

  // Salón al que pertenece este día cerrado.
  tenantId String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, date])
  @@index([tenantId])
}

model ScheduleOverride {
  id        String   @id @default(uuid())
  date      String // YYYY-MM-DD
  timeSlots String[] @default([])

  // Salón al que pertenece esta excepción de horario.
  tenantId String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, date])
  @@index([tenantId])
}

// ================= Enums adicionales =================

enum BillingCycle {
  ONE_TIME
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  YEARLY
}

enum BookingMode {
  TIMED
  QUOTA
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum AppointmentStatus {
  PENDING // Reservada, pendiente de confirmar
  SCHEDULED // Confirmada
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum CancelledBy {
  CUSTOMER
  STAFF
  SYSTEM
}

enum BookingSource {
  ADMIN
  PORTAL
  PUBLIC
}

enum Vertical {
  GENERIC
  NAILS
  BARBER
  SPA
  TATTOO
  HAIR
  FITNESS
}

enum NotificationType {
  WHATSAPP
  EMAIL
  TELEGRAM
  SYSTEM
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

// Sesiones renovables. El access token dura 15 minutos; este token opaco (que
// viaja en una cookie httpOnly) se rota en cada renovación. Solo se guarda su
// hash. Es una tabla de sesión, sin RLS: se consulta antes de saber el salón.
// Enlace secreto para suscribir la agenda en Google Calendar, Apple Calendar u Outlook (formato iCal).
// Sin RLS (como RefreshToken): la petición viene de un programa de calendario sin sesión; el token
// es la credencial y solo se guarda su hash. Una cuenta tiene un solo enlace; regenerarlo anula el anterior.
model CalendarFeed {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId   String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
}

model RefreshToken {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId   String
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String? // hash del token que lo sustituyó (rotación)
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
  @@index([expiresAt])
}

// ================= Modelos de plataforma (Super Admin) =================

// Cuenta de quien administra el SaaS (no un usuario de ningún salón). Tabla
// separada de User a propósito: su JWT no lleva tenantId y el de un salón no
// sirve aquí, así que ambos sistemas de sesión quedan aislados por diseño.
model PlatformAdmin {
  id          String       @id @default(uuid())
  email       String       @unique
  password    String
  name        String
  role        PlatformRole @default(SUPER_ADMIN)
  isActive    Boolean      @default(true)
  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Catálogo de planes que el SaaS vende a los salones (Free/Basic/Pro/...).
// No confundir con Service, que es el catálogo de servicios que CADA salón
// vende a sus propias clientas.
model Plan {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?

  priceMonthly Decimal @db.Decimal(10, 2)
  priceYearly  Decimal @db.Decimal(10, 2)
  currency     String  @default("USD")

  trialDays Int @default(0)

  // Límites del plan. null = ilimitado.
  maxStaff                Int?
  maxAppointmentsPerMonth Int?
  maxLocations            Int?

  // Lista de claves de features activas para este plan (ej. ["whatsapp_notifications","multi_location"]).
  features Json @default("[]")

  isActive  Boolean @default(true)
  isPublic  Boolean @default(true) // visible en la página pública de precios
  sortOrder Int     @default(0)

  // Id del "preapproval_plan" (plantilla de suscripción) creado en Mercado
  // Pago para este plan, por ciclo de cobro. Se crean de forma perezosa la
  // primera vez que un salón intenta pagar ese ciclo, y se cachean acá para
  // no crear un plan duplicado en Mercado Pago en cada checkout.
  mpPlanIdMonthly String?
  mpPlanIdYearly  String?

  tenantSubscriptions TenantSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// La suscripción de UN salón (tenant) a un Plan de la plataforma. Una por
// tenant (la actual); los cambios de plan/estado quedan en AuditLog.
model TenantSubscription {
  id       String @id @default(uuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  status       TenantSubscriptionStatus @default(TRIALING)
  billingCycle BillingCycle             @default(MONTHLY)

  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime
  trialEndsAt        DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  canceledAt         DateTime?

  // Referencias a la pasarela de pago (Mercado Pago / Stripe / etc.), cuando
  // se conecte una; hasta entonces la suscripción se administra a mano.
  gateway                String?
  externalCustomerId     String?
  externalSubscriptionId String?

  invoices PlatformInvoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId])
  @@index([status])
}

// Lo que el SaaS le factura al salón (no lo que el salón factura a sus
// clientas).
model PlatformInvoice {
  id            String @id @default(uuid())
  invoiceNumber String @unique

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  tenantSubscriptionId String?
  tenantSubscription   TenantSubscription? @relation(fields: [tenantSubscriptionId], references: [id], onDelete: SetNull)

  amount   Decimal               @db.Decimal(10, 2)
  currency String                @default("USD")
  status   PlatformInvoiceStatus @default(PENDING)

  issueDate DateTime  @default(now())
  dueDate   DateTime
  paidAt    DateTime?

  gateway           String?
  externalPaymentId String?
  notes             String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([tenantSubscriptionId])
}

// Bitácora de auditoría a nivel de plataforma: qué hizo un super admin (o,
// potencialmente, un evento relevante de un usuario de salón) y cuándo.
// Cubre en particular cada impersonación, que siempre debe quedar registrada.
model AuditLog {
  id         String         @id @default(uuid())
  actorType  AuditActorType
  actorId    String
  actorEmail String?
  action     String
  targetType String?
  targetId   String?
  tenantId   String?
  metadata   Json?
  ip         String?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([tenantId])
  @@index([action])
  @@index([createdAt])
}
