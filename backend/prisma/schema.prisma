// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ================= Enums =================

enum Role {
  ADMIN
  CLIENT
}

enum InvoiceStatus {
  PENDING
  PAID
  CANCELLED
  OVERDUE // Añadido: útil para facturas vencidas
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  COMPLETED
  ON_HOLD
}

enum ClientType {
  CUSTOMER
  SUPPLIER
}

enum TenantStatus {
  ACTIVE
  TRIAL
  SUSPENDED
}

// ================= Plataforma (Super Admin) =================
// Todo lo de aquí abajo es a nivel de la plataforma SaaS, no de un salón
// (tenant) concreto: quién administra la plataforma, qué le cobra a cada
// salón y con qué plan. Se mantiene deliberadamente separado de los modelos
// de negocio de cada salón (Subscription/Invoice son lo que EL SALÓN le
// cobra a SUS clientas; esto es lo que EL SAAS le cobra AL SALÓN).

enum PlatformRole {
  SUPER_ADMIN
  SUPPORT
  BILLING_ADMIN
}

enum TenantSubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum PlatformInvoiceStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  VOID
}

enum AuditActorType {
  PLATFORM_ADMIN
  TENANT_USER
}

// ================= Models =================

// Un Tenant representa un salón individual suscrito al SaaS. Es la base de la
// separación multitenant: toda tabla de datos de negocio lleva tenantId para
// que los datos de un salón nunca sean visibles para otro.
//
// tenantId es obligatorio (NOT NULL) en todas las tablas de datos de negocio,
// salvo Ticket: el sistema de tickets de soporte es funcionalidad heredada sin
// ninguna ruta ni pantalla que lo use, así que se deja fuera del alcance del
// aislamiento multitenant en vez de invertir en scoping de código muerto.
model Tenant {
  id       String       @id @default(uuid())
  name     String // Nombre comercial del salón
  slug     String       @unique // Para URLs/subdominio futuro (ej. saloncarla)
  currency String       @default("USD")
  timezone String       @default("UTC")
  status   TenantStatus @default(ACTIVE)

  users             User[]
  clients           Client[]
  projects          Project[]
  products          Product[]
  categories        Category[]
  staff             Staff[]
  appointments      Appointment[]
  businessHours     BusinessHour[]
  closedDates       ClosedDate[]
  scheduleOverrides ScheduleOverride[]
  invoices          Invoice[]
  subscriptions     Subscription[]
  tickets           Ticket[]
  knowledgeBase     KnowledgeBase[]
  notifications     Notification[]
  galleryItems      GalleryItem[]

  // Suscripción de este salón a un Plan de la plataforma (lo que el SaaS le
  // cobra al salón), y sus facturas de plataforma. Distinto de Subscription/
  // Invoice, que son la facturación del salón a SUS clientas.
  platformSubscription TenantSubscription?
  platformInvoices     PlatformInvoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  username String? @unique
  password String // Hash de la contraseña (e.g., bcrypt)
  name     String
  role     Role    @default(CLIENT) // ADMIN o CLIENT

  // Salón al que pertenece este usuario (admin o clienta).
  tenantId String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Foto de perfil (Base64)
  imageUrl String? @db.Text

  // Relación con Client (un user puede estar asociado a un cliente)
  clientId String?
  client   Client? @relation("UserAsClient", fields: [clientId], references: [id], onDelete: SetNull)

  // Relaciones existentes
  projects Project[]
  clients  Client[]  @relation("AdminofClient") // Relación inversa: admin de varios clientes
  invoices Invoice[]

  // Nuevas relaciones para HostBilling
  products       Product[]
  subscriptions  Subscription[]
  tickets        Ticket[]        @relation("TicketAssignee")
  ticketCreators Ticket[]        @relation("TicketCreator")
  ticketMessages TicketMessage[]
  knowledgeBase  KnowledgeBase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([tenantId])
}

model Client {
  id    String  @id @default(uuid())
  name  String
  email String
  code  String?

  // Salón al que pertenece esta clienta.
  tenantId String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  displayName    String?
  businessNumber String?
  type           ClientType @default(CUSTOMER)
  phone          String?
  company        String?
  address        String?    @db.Text
  city           String?
  state          String?
  zipCode        String?
  country        String?
  secondaryEmail String?
  currency       String     @default("USD")
  groupId        String?
  ownerId        String?
  taxId          String? // CIF/NIF/RUT para la facturación

  // Foto de perfil (Base64)
  imageUrl String? @db.Text

  // Claves foráneas
  userId String
  user   User   @relation("AdminofClient", fields: [userId], references: [id], onDelete: Cascade)

  // Usuarios (clientes) vinculados a este cliente
  clientUsers User[] @relation("UserAsClient")

  // Relaciones existentes
  projects Project[]
  invoices Invoice[]

  // Nuevas relaciones para HostBilling
  subscriptions Subscription[]
  tickets       Ticket[]

  // Relación con citas
  appointments Appointment[]

  // Relación con notificaciones
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, email])
  @@index([userId])
  @@index([tenantId])
}

model Project {
  id          String        @id @default(uuid())
  name        String
  description String?       @db.Text
  status      ProjectStatus @default(ACTIVE)

  // Salón al que pertenece este proyecto.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Claves foráneas
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Relaciones
  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([tenantId])
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String
  issueDate     DateTime      @default(now())
  dueDate       DateTime
  status        InvoiceStatus @default(PENDING)

  // Usamos Decimal para evitar errores de coma flotante en dinero
  subtotal    Decimal @db.Decimal(10, 2)
  taxRate     Decimal @default(0) @db.Decimal(5, 2) // Porcentaje de impuestos (ej. 21.00)
  totalAmount Decimal @db.Decimal(10, 2)
  notes       String? @db.Text

  // Salón al que pertenece esta factura.
  tenantId String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Claves foráneas
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // Relaciones
  items      InvoiceItem[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, invoiceNumber])
  @@index([clientId])
  @@index([invoiceNumber])
  @@index([userId])
  @@index([tenantId])
}

model InvoiceItem {
  id          String  @id @default(uuid())
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  // Clave foránea
  invoiceId String
  // Si se borra la factura, se borran sus items (Cascade)
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// ================= Nuevas entidades para HostBilling =================

// Categorías para organizar productos y tickets
model Category {
  id          String       @id @default(uuid())
  name        String
  description String?
  type        CategoryType // PRODUCT, TICKET, KNOWLEDGE_BASE
  color       String? // Para UI (hex color)
  icon        String? // Nombre del icono
  order       Int          @default(0) // Para ordenar categorías

  // Salón al que pertenece esta categoría.
  tenantId String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Relaciones
  products Product[]
  tickets  Ticket[]
  articles KnowledgeBase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name, type])
  @@index([tenantId])
}

// Productos y Servicios
model Product {
  id          String      @id @default(uuid())
  name        String
  description String?     @db.Text
  type        ProductType // MANICURA_BASICA, DISENO_ARTISTICO, UÑAS_ACRILICAS, UÑAS_GEL, PEDICURA, REPARACION, EXTENSIONES, TRATAMIENTO_SPA

  // Precios
  price        Decimal      @db.Decimal(10, 2)
  currency     String       @default("USD")
  billingCycle BillingCycle // MONTHLY, YEARLY, ONE_TIME, QUARTERLY

  // Estado y configuración
  status          ProductStatus @default(ACTIVE)
  isPublic        Boolean       @default(true) // Visible en portal de cliente
  stock           Int? // Para productos limitados (null = unlimited)
  durationMinutes Int           @default(60) // Duración del servicio; determina la hora de fin de la cita

  // Salón al que pertenece este producto/servicio.
  tenantId String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Categorización
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  // Usuario que creó el producto
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Relaciones
  subscriptions Subscription[]
  orderItems    OrderItem[]
  appointments  Appointment[]
  galleryItems  GalleryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([userId])
  @@index([type])
  @@index([tenantId])
}

model GalleryItem {
  id       String  @id @default(uuid())
  title    String
  imageUrl String  @db.Text
  isActive Boolean @default(true)

  // Salón al que pertenece este diseño.
  tenantId String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([tenantId])
}

// Órdenes/Suscripciones
model Subscription {
  id                 String             @id @default(uuid())
  subscriptionNumber String
  status             SubscriptionStatus @default(ACTIVE)

  // Fechas importantes
  startDate   DateTime  @default(now())
  endDate     DateTime?
  nextBilling DateTime?
  cancelledAt DateTime?

  // Salón al que pertenece esta suscripción.
  tenantId String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Producto suscrito
  productId String
  product   Product @relation(fields: [productId], references: [id])

  // Cliente suscriptor
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  // Usuario que gestiona
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Configuración de facturación
  autoRenew Boolean @default(true)
  notes     String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, subscriptionNumber])
  @@index([clientId])
  @@index([productId])
  @@index([userId])
  @@index([status])
  @@index([tenantId])
}

// Items de órdenes (para compras únicas)
model OrderItem {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity  Int     @default(1)
  unitPrice Decimal @db.Decimal(10, 2)
  total     Decimal @db.Decimal(10, 2)

  // Relación con invoice (opcional, para compras que generan factura)
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([invoiceId])
}

// Sistema de Tickets de Soporte
model Ticket {
  id           String       @id @default(uuid())
  ticketNumber String       @unique
  subject      String
  description  String       @db.Text
  status       TicketStatus @default(OPEN)
  priority     Priority     @default(MEDIUM)

  // Salón al que pertenece este ticket (opcional por ahora; se vuelve obligatoria cuando se filtren las rutas por tenant, en la siguiente fase).
  tenantId String?

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Categorización
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  // Cliente que creó el ticket
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  // Usuario asignado (agente de soporte)
  assignedToId String?
  assignedTo   User?   @relation("TicketAssignee", fields: [assignedToId], references: [id])

  // Usuario que creó el ticket
  userId String
  user   User   @relation("TicketCreator", fields: [userId], references: [id])

  // Relaciones
  messages TicketMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // NOTA (fase 2 pendiente): igual que invoiceNumber, se acotará por tenant
  // junto con el filtrado de rutas.
  @@index([clientId])
  @@index([categoryId])
  @@index([assignedToId])
  @@index([status])
  @@index([tenantId])
}

// Mensajes en tickets
model TicketMessage {
  id         String  @id @default(uuid())
  message    String  @db.Text
  isInternal Boolean @default(false) // Solo visible para agentes

  // Usuario que envió el mensaje
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Ticket al que pertenece
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([userId])
}

// Knowledge Base (Base de Conocimiento)
model KnowledgeBase {
  id      String  @id @default(uuid())
  title   String
  content String  @db.Text
  excerpt String? @db.Text // Resumen corto
  slug    String // Para URLs amigables

  // Salón al que pertenece este artículo.
  tenantId String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Categorización
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  // Estado
  status   KBStatus @default(PUBLISHED)
  isPublic Boolean  @default(true) // Visible para clientes

  // Usuario que creó el artículo
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Metadata
  views      Int @default(0)
  helpful    Int @default(0) // Votos positivos
  notHelpful Int @default(0) // Votos negativos

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, slug])
  @@index([categoryId])
  @@index([userId])
  @@index([tenantId])
  @@index([status])
}

// Profesionales del salón. El horario comercial (BusinessHour) sigue siendo
// general para todo el salón; asignar una cita a un Staff es informativo por
// ahora y no implica horarios ni cupos independientes por profesional.
model Staff {
  id       String  @id @default(uuid())
  name     String
  email    String?
  phone    String?
  color    String? // Para distinguir profesionales en la agenda (hex color)
  isActive Boolean @default(true)

  // Salón al que pertenece este profesional.
  tenantId String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([tenantId])
}

// Sistema de Citas (Appointments)
model Appointment {
  id        String            @id @default(uuid())
  date      DateTime // Fecha exacta de la cita
  startTime String // Hora de inicio (Ej: "10:00")
  endTime   String // Hora de fin (Ej: "11:30")
  status    AppointmentStatus @default(SCHEDULED)
  notes     String?           @db.Text

  // Salón al que pertenece esta cita.
  tenantId String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Relaciones
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  // Profesional que atiende la cita (opcional: el horario sigue siendo general del salón)
  staffId String?
  staff   Staff?  @relation(fields: [staffId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([productId])
  @@index([staffId])
  @@index([date])
  @@index([status])
  @@index([tenantId])
}

model Notification {
  id        String             @id @default(uuid())
  type      NotificationType // WHATSAPP, EMAIL, SYSTEM
  recipient String // Número de teléfono, email o ID interno
  content   String             @db.Text // Texto del mensaje
  status    NotificationStatus @default(PENDING)
  isRead    Boolean            @default(false) // Para la campanita del cliente
  errorLog  String?            @db.Text // Log de errores si falla el envío

  // Salón que envió esta notificación.
  tenantId String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Relaciones
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([isRead])
  @@index([createdAt])
  @@index([tenantId])
}

// Horarios Comerciales
model BusinessHour {
  id              String   @id @default(uuid())
  dayOfWeek       Int // 0 = Domingo, 1 = Lunes, ..., 6 = Sábado
  startTime       String // Ej: "09:00" (retrocompatibilidad)
  endTime         String // Ej: "18:00" (retrocompatibilidad)
  timeSlots       String[] @default([]) // Horarios explícitos definidos por el administrador
  isOpen          Boolean  @default(true) // Si es false, ese día está cerrado
  maxAppointments Int      @default(0) // 0 = sin límite, >0 = límite máximo de citas por día

  // Salón al que pertenece este horario.
  tenantId String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, dayOfWeek])
  @@index([dayOfWeek])
  @@index([tenantId])
}

model ClosedDate {
  id     String  @id @default(uuid())
  date   String // YYYY-MM-DD
  reason String? @db.Text

  // Salón al que pertenece este día cerrado.
  tenantId String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, date])
  @@index([tenantId])
}

model ScheduleOverride {
  id        String   @id @default(uuid())
  date      String // YYYY-MM-DD
  timeSlots String[] @default([])

  // Salón al que pertenece esta excepción de horario.
  tenantId String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, date])
  @@index([tenantId])
}

// ================= Enums adicionales =================

enum CategoryType {
  PRODUCT
  TICKET
  KNOWLEDGE_BASE
}

enum ProductType {
  MANICURA_BASICA
  DISENO_ARTISTICO
  UÑAS_ACRILICAS
  UÑAS_GEL
  PEDICURA
  REPARACION
  EXTENSIONES
  TRATAMIENTO_SPA
}

enum BillingCycle {
  ONE_TIME
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  YEARLY
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum SubscriptionStatus {
  ACTIVE
  PENDING
  CANCELLED
  EXPIRED
  SUSPENDED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CLIENT
  RESOLVED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum KBStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum NotificationType {
  WHATSAPP
  EMAIL
  SYSTEM
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

// ================= Modelos de plataforma (Super Admin) =================

// Cuenta de quien administra el SaaS (no un usuario de ningún salón). Tabla
// separada de User a propósito: su JWT no lleva tenantId y el de un salón no
// sirve aquí, así que ambos sistemas de sesión quedan aislados por diseño.
model PlatformAdmin {
  id          String       @id @default(uuid())
  email       String       @unique
  password    String
  name        String
  role        PlatformRole @default(SUPER_ADMIN)
  isActive    Boolean      @default(true)
  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Catálogo de planes que el SaaS vende a los salones (Free/Basic/Pro/...).
// No confundir con Product, que es el catálogo de servicios que CADA salón
// vende a sus propias clientas.
model Plan {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?

  priceMonthly Decimal @db.Decimal(10, 2)
  priceYearly  Decimal @db.Decimal(10, 2)
  currency     String  @default("USD")

  trialDays Int @default(0)

  // Límites del plan. null = ilimitado.
  maxStaff                Int?
  maxAppointmentsPerMonth Int?
  maxLocations            Int?

  // Lista de claves de features activas para este plan (ej. ["whatsapp_notifications","multi_location"]).
  features Json @default("[]")

  isActive  Boolean @default(true)
  isPublic  Boolean @default(true) // visible en la página pública de precios
  sortOrder Int     @default(0)

  // Id del "preapproval_plan" (plantilla de suscripción) creado en Mercado
  // Pago para este plan, por ciclo de cobro. Se crean de forma perezosa la
  // primera vez que un salón intenta pagar ese ciclo, y se cachean acá para
  // no crear un plan duplicado en Mercado Pago en cada checkout.
  mpPlanIdMonthly String?
  mpPlanIdYearly  String?

  tenantSubscriptions TenantSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// La suscripción de UN salón (tenant) a un Plan de la plataforma. Una por
// tenant (la actual); los cambios de plan/estado quedan en AuditLog.
model TenantSubscription {
  id       String @id @default(uuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  status       TenantSubscriptionStatus @default(TRIALING)
  billingCycle BillingCycle             @default(MONTHLY)

  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime
  trialEndsAt        DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  canceledAt         DateTime?

  // Referencias a la pasarela de pago (Mercado Pago / Stripe / etc.), cuando
  // se conecte una; hasta entonces la suscripción se administra a mano.
  gateway                 String?
  externalCustomerId      String?
  externalSubscriptionId  String?

  invoices PlatformInvoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId])
  @@index([status])
}

// Lo que el SaaS le factura al salón (no lo que el salón factura a sus
// clientas — eso es el modelo Invoice).
model PlatformInvoice {
  id            String @id @default(uuid())
  invoiceNumber String @unique

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  tenantSubscriptionId String?
  tenantSubscription   TenantSubscription? @relation(fields: [tenantSubscriptionId], references: [id], onDelete: SetNull)

  amount   Decimal                @db.Decimal(10, 2)
  currency String                 @default("USD")
  status   PlatformInvoiceStatus  @default(PENDING)

  issueDate DateTime  @default(now())
  dueDate   DateTime
  paidAt    DateTime?

  gateway           String?
  externalPaymentId String?
  notes             String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([tenantSubscriptionId])
}

// Bitácora de auditoría a nivel de plataforma: qué hizo un super admin (o,
// potencialmente, un evento relevante de un usuario de salón) y cuándo.
// Cubre en particular cada impersonación, que siempre debe quedar registrada.
model AuditLog {
  id         String         @id @default(uuid())
  actorType  AuditActorType
  actorId    String
  actorEmail String?
  action     String
  targetType String?
  targetId   String?
  tenantId   String?
  metadata   Json?
  ip         String?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([tenantId])
  @@index([action])
  @@index([createdAt])
}
