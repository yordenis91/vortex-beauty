JWT_SECRET=cambia-esto
# PLATFORM_JWT_SECRET=otro-secreto-distinto
# CORS_ORIGINS=https://app.ejemplo.com
PORT=3001

# Respaldos diarios a S3 compatible (MinIO). Sin las cuatro primeras no se hacen copias.
# BACKUP_S3_ENDPOINT=https://minio.ejemplo.com
# BACKUP_S3_BUCKET=respaldos
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_REGION=us-east-1
# BACKUP_CRON=0 3 * * *
# BACKUP_TZ=UTC
# BACKUP_RETENTION_DAYS=30
# El dump necesita un usuario sin RLS: por defecto usa MIGRATE_DATABASE_URL, luego DATABASE_URL.
# BACKUP_DATABASE_URL=
# BACKUP_HEARTBEAT_URL=https://hc-ping.com/<uuid>

